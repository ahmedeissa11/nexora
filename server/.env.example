# =============================================================================
# NEXORA backend environment — names and placeholders only. Never real secrets.
# Copy to server/.env locally. Set the same names in Railway. Never commit .env.
# Never put these values in the browser, Git, or Vercel frontend env.
# =============================================================================

# --- PostgreSQL (SERVER ONLY) ---
# Production: Supabase pooled URI, port 6543, pgbouncer=true, sslmode=require
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/nexora"

# Direct Postgres for Prisma migrations (Supabase port 5432, no pgbouncer).
# DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/nexora"

# Then: npx prisma migrate deploy
# Never: prisma migrate reset / db drop / truncate

# Express-managed HttpOnly session + cart_token HMAC (SERVER ONLY)
SESSION_SECRET="change-me-to-a-long-random-string"

PORT=3000
NODE_ENV=development
ORDER_RESERVATION_MINUTES=15

# Railway production: leave SERVE_STATIC unset (defaults off when NODE_ENV=production).
# Local/dev serves the vanilla SPA from the repo root. Do not use Railway as the public site.
# SERVE_STATIC=0

# --- Frontend origin (production) ---
# https origin of the Vercel storefront. Used for Stripe success/cancel URLs
# and added to the Origin allowlist. SERVER configuration, not a secret.
# PUBLIC_ORIGIN="https://shop.example.com"
# FRONTEND_ORIGIN is an alias of PUBLIC_ORIGIN.

# Extra allowed browser Origins for credentialed CORS + mutation Origin guard.
# Comma-separated exact https origins. Never *. The request Host is always allowed.
# ALLOWED_ORIGINS="https://shop.example.com"

# Cross-site cookies (browser → Railway directly, no Vercel /api rewrite).
# Requires SameSite=None; Secure and ALLOWED_ORIGINS. Default off (SameSite=Lax).
# CROSS_SITE_COOKIES=1

# --- Supabase Auth (SERVER ONLY). Required in production. ---
# Never put SUPABASE_SERVICE_ROLE_KEY in the browser or Vercel frontend env.
# Production refuses to boot without a real project URL + both keys.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Stripe (SERVER ONLY). Required in production. Never STRIPE_MOCK=1 in prod. ---
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_PUBLISHABLE_KEY="pk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_CURRENCY="usd"
# STRIPE_MOCK=1

# Admin bootstrap — SERVER ONLY, one-time HTTP promote of an EXISTING user.
# ADMIN_BOOTSTRAP_EMAIL="ops@example.com"
# ADMIN_BOOTSTRAP_SECRET=""
